# Required
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional (defaults shown)
GROQ_MODEL=openai/gpt-oss-20b
GRADIO_SERVER_PORT=7860
# Bind to 0.0.0.0 inside containers/cloud; 127.0.0.1 for local dev
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_BROWSER_STORAGE_SECRET=replace-with-a-stable-random-string

# Scaling knobs for serving thousands of users
CHAT_CONCURRENCY_LIMIT=32
QUEUE_MAX_SIZE=1000
GRADIO_MAX_THREADS=64
API_ENABLE=true

# Rate limiting (per client IP, sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=150

# Reverse-proxy prefix, if the app is mounted under a subpath
# GRADIO_ROOT_PATH=
